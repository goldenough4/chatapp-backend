<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/call_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A"
    android:fitsSystemWindows="true">

    <!-- Video Renderers (Video Mode) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_video_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/local_video_card"
        android:layout_width="110dp"
        android:layout_height="160dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar_container">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_encryption_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:text="🔒 End-to-end encrypted"
            android:textColor="#8696A0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/call_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Mamitaaa" />

        <TextView
            android:id="@+id/call_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#AEBAC1"
            android:textSize="15sp"
            tools:text="Ringing..." />
    </LinearLayout>

    <!-- Center Avatar Container (Voice Mode) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/call_profile_image"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_default_user"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/voice_controls_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar_container"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <!-- Incoming Call Accept/Decline Overlay Card -->
    <LinearLayout
        android:id="@+id/incoming_call_actions_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_decline_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Decline"
                android:src="@drawable/ic_call_end"
                app:srcCompat="@drawable/ic_call_end"
                app:backgroundTint="#EA0038"
                app:fabCustomSize="72dp"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Decline"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_accept_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Accept"
                android:src="@drawable/ic_call_accept"
                app:srcCompat="@drawable/ic_call_accept"
                app:backgroundTint="#00A884"
                app:fabCustomSize="72dp"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Accept"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/video_floating_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar_container">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Switch Camera"
            android:src="@drawable/ic_call_video"
            app:srcCompat="@drawable/ic_call_video"
            app:backgroundTint="#202C33"
            app:fabCustomSize="48dp"
            app:tint="#FFFFFF" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_effects"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Effects"
            android:src="@drawable/ic_call_more"
            app:srcCompat="@drawable/ic_call_more"
            app:backgroundTint="#202C33"
            app:fabCustomSize="48dp"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Voice Call 2x3 Bottom Control Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/voice_controls_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#1F2C34"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Row 1: Speaker, Video, Mute -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btn_speaker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Speaker"
                        android:src="@drawable/ic_call_speaker"
                        app:srcCompat="@drawable/ic_call_speaker"
                        app:backgroundTint="#2A3942"
                        app:fabCustomSize="56dp"
                        app:tint="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btn_toggle_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Video"
                        android:src="@drawable/ic_call_video"
                        app:srcCompat="@drawable/ic_call_video"
                        app:backgroundTint="#2A3942"
                        app:fabCustomSize="56dp"
                        app:tint="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btn_mute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Mute"
                        android:src="@drawable/ic_call_mic"
                        app:srcCompat="@drawable/ic_call_mic"
                        app:backgroundTint="#2A3942"
                        app:fabCustomSize="56dp"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: More, Share, End -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btn_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="More"
                        android:src="@drawable/ic_call_more"
                        app:srcCompat="@drawable/ic_call_more"
                        app:backgroundTint="#2A3942"
                        app:fabCustomSize="56dp"
                        app:tint="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btn_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Share"
                        android:src="@drawable/ic_call_share"
                        app:srcCompat="@drawable/ic_call_share"
                        app:backgroundTint="#2A3942"
                        app:fabCustomSize="56dp"
                        app:tint="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btn_end_call"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="End Call"
                        android:src="@drawable/ic_call_end"
                        app:srcCompat="@drawable/ic_call_end"
                        app:backgroundTint="#EA0038"
                        app:fabCustomSize="56dp"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="End"
                        android:textColor="#EA0038"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
