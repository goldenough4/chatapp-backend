<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ChatApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#075E54</item>
        <item name="colorPrimaryVariant">#128C7E</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">#25D366</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeBackground">@color/whatsapp_action_mode</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ChatInputStyle">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:hint">@string/type_a_message</item>
    </style>

</resources>